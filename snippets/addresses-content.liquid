{{ 'addresses.css' | asset_url | stylesheet_tag }}
<script src="{{ 'addresses.js' | asset_url }}" defer></script>

{%- paginate customer.addresses by 10 -%}

{% comment %} ===== ADD NEW ADDRESS MODAL ===== {% endcomment %}
<div class="modal fade address-modal" id="addAddressModal" tabindex="-1" aria-labelledby="addAddressModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      {%- form 'customer_address', customer.new_address -%}
        <div class="modal-header">
          <h5 class="modal-title" id="addAddressModalLabel">Add New Address</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="address-form">
            <div class="form-row">
              <div class="form-group">
                <label for="AddressFirstNameNew">First Name</label>
                <input type="text" id="AddressFirstNameNew" name="address[first_name]" class="form-control" value="{{ form.first_name }}" autocomplete="given-name" placeholder="First name">
              </div>
              <div class="form-group">
                <label for="AddressLastNameNew">Last Name</label>
                <input type="text" id="AddressLastNameNew" name="address[last_name]" class="form-control" value="{{ form.last_name }}" autocomplete="family-name" placeholder="Last name">
              </div>
            </div>
            <div class="form-group">
              <label for="AddressCompanyNew">Company <span style="font-weight:400;text-transform:none;">(optional)</span></label>
              <input type="text" id="AddressCompanyNew" name="address[company]" class="form-control" value="{{ form.company }}" autocomplete="organization" placeholder="Company">
            </div>
            <div class="form-group">
              <label for="AddressAddress1New">Address</label>
              <input type="text" id="AddressAddress1New" name="address[address1]" class="form-control" value="{{ form.address1 }}" autocomplete="address-line1" placeholder="Street address">
            </div>
            <div class="form-group">
              <label for="AddressAddress2New">Apartment, suite, etc. <span style="font-weight:400;text-transform:none;">(optional)</span></label>
              <input type="text" id="AddressAddress2New" name="address[address2]" class="form-control" value="{{ form.address2 }}" autocomplete="address-line2" placeholder="Apt, suite, unit, etc.">
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="AddressCityNew">City</label>
                <input type="text" id="AddressCityNew" name="address[city]" class="form-control" value="{{ form.city }}" autocomplete="address-level2" placeholder="City">
              </div>
              <div class="form-group">
                <label for="AddressZipNew">ZIP / Postal Code</label>
                <input type="text" id="AddressZipNew" name="address[zip]" class="form-control" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" placeholder="Postal code">
              </div>
            </div>
            <div class="form-group">
              <label for="AddressCountryNew">Country</label>
              <select id="AddressCountryNew" name="address[country]" class="form-control" data-default="{{ form.country }}" autocomplete="country">
                {{ all_country_option_tags }}
              </select>
            </div>
            <div id="AddressProvinceContainerNew" class="form-group" style="display:none">
              <label for="AddressProvinceNew">Province / State</label>
              <select id="AddressProvinceNew" name="address[province]" class="form-control" data-default="{{ form.province }}" autocomplete="address-level1"></select>
            </div>
            <div class="form-group">
              <label for="AddressPhoneNew">Phone <span style="font-weight:400;text-transform:none;">(optional)</span></label>
              <input type="tel" id="AddressPhoneNew" name="address[phone]" class="form-control" value="{{ form.phone }}" autocomplete="tel" placeholder="Phone number">
            </div>
            <div class="default-checkbox">
              {{ form.set_as_default_checkbox }}
              <label for="address_default_address_new">Set as default address</label>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-cancel-address" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn-save-address">Add Address</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% comment %} ===== EDIT ADDRESS MODALS ===== {% endcomment %}
{%- for address in customer.addresses -%}
<div class="modal fade address-modal" id="editAddressModal_{{ address.id }}" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      {%- form 'customer_address', address -%}
        <div class="modal-header">
          <h5 class="modal-title">Edit Address</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="address-form">
            <div class="form-row">
              <div class="form-group">
                <label>First Name</label>
                <input type="text" id="AddressFirstName_{{ form.id }}" name="address[first_name]" class="form-control" value="{{ form.first_name }}" autocomplete="given-name">
              </div>
              <div class="form-group">
                <label>Last Name</label>
                <input type="text" id="AddressLastName_{{ form.id }}" name="address[last_name]" class="form-control" value="{{ form.last_name }}" autocomplete="family-name">
              </div>
            </div>
            <div class="form-group">
              <label>Company <span style="font-weight:400;text-transform:none;">(optional)</span></label>
              <input type="text" id="AddressCompany_{{ form.id }}" name="address[company]" class="form-control" value="{{ form.company }}" autocomplete="organization">
            </div>
            <div class="form-group">
              <label>Address</label>
              <input type="text" id="AddressAddress1_{{ form.id }}" name="address[address1]" class="form-control" value="{{ form.address1 }}" autocomplete="address-line1">
            </div>
            <div class="form-group">
              <label>Apartment, suite, etc. <span style="font-weight:400;text-transform:none;">(optional)</span></label>
              <input type="text" id="AddressAddress2_{{ form.id }}" name="address[address2]" class="form-control" value="{{ form.address2 }}" autocomplete="address-line2">
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>City</label>
                <input type="text" id="AddressCity_{{ form.id }}" name="address[city]" class="form-control" value="{{ form.city }}" autocomplete="address-level2">
              </div>
              <div class="form-group">
                <label>ZIP / Postal Code</label>
                <input type="text" id="AddressZip_{{ form.id }}" name="address[zip]" class="form-control" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code">
              </div>
            </div>
            <div class="form-group">
              <label>Country</label>
              <select id="AddressCountry_{{ form.id }}" name="address[country]" class="form-control" data-address-country-select data-default="{{ form.country }}" data-form-id="{{ form.id }}" autocomplete="country">
                {{ all_country_option_tags }}
              </select>
            </div>
            <div id="AddressProvinceContainer_{{ form.id }}" class="form-group" style="display:none">
              <label>Province / State</label>
              <select id="AddressProvince_{{ form.id }}" name="address[province]" class="form-control" data-default="{{ form.province }}" autocomplete="address-level1"></select>
            </div>
            <div class="form-group">
              <label>Phone <span style="font-weight:400;text-transform:none;">(optional)</span></label>
              <input type="tel" id="AddressPhone_{{ form.id }}" name="address[phone]" class="form-control" value="{{ form.phone }}" autocomplete="tel">
            </div>
            <div class="default-checkbox">
              {{ form.set_as_default_checkbox }}
              <label for="address_default_address_{{ form.id }}">Set as default address</label>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-cancel-address" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn-save-address">Save Address</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>
{%- endfor -%}

{% comment %} ===== PAGE CONTENT ===== {% endcomment %}
<div class="addresses-page">

  <div class="addresses-header">
    <h1>Shipping Addresses</h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addAddressModal">
      <i class="bi bi-plus-lg"></i>
      Add New Address
    </button>
  </div>

  {%- if customer.addresses_count == 0 -%}
    <div class="addresses-empty">
      <i class="bi bi-geo-alt"></i>
      <p>You haven't saved any addresses yet.</p>
      <button type="button" class="btn-add-address" data-bs-toggle="modal" data-bs-target="#addAddressModal">
        <i class="bi bi-plus-lg"></i>
        Add Your First Address
      </button>
    </div>

  {%- else -%}
    <div class="address-cards-grid">
      {%- for address in customer.addresses -%}
        <div class="address-card{% if address == customer.default_address %} is-default{% endif %}">
          {%- if address == customer.default_address -%}
            <span class="address-default-badge">Default</span>
          {%- endif -%}

          <div class="address-card-name">{{ address.first_name }} {{ address.last_name }}</div>
          <div class="address-card-body">
            {%- if address.company != blank -%}
              <div>{{ address.company }}</div>
            {%- endif -%}
            <div>{{ address.address1 }}</div>
            {%- if address.address2 != blank -%}
              <div>{{ address.address2 }}</div>
            {%- endif -%}
            <div>
              {{ address.city }}{%- if address.province != blank -%}, {{ address.province_code }}{%- endif -%} {{ address.zip }}
            </div>
            <div>{{ address.country }}</div>
            {%- if address.phone != blank -%}
              <div>{{ address.phone }}</div>
            {%- endif -%}
          </div>

          <div class="address-card-actions">
            <button
              type="button"
              class="btn-address-edit"
              data-bs-toggle="modal"
              data-bs-target="#editAddressModal_{{ address.id }}"
            >
              <i class="bi bi-pencil"></i>
              Edit
            </button>
            <button
              type="button"
              class="btn-address-delete"
              data-target="{{ address.url }}"
              data-confirm-message="{{ 'customer.addresses.delete_confirm' | t }}"
              aria-label="Delete address"
            >
              <i class="bi bi-trash"></i>
            </button>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      {%- if paginate.parts.size > 0 -%}
        <nav class="addresses-pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
              <i class="bi bi-chevron-left"></i>
            </a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
            {%- else -%}
              {%- if part.title == paginate.current_page -%}
                <span aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span>{{ part.title }}</span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
              <i class="bi bi-chevron-right"></i>
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endif -%}

  {%- endif -%}

</div>

{%- endpaginate -%}
