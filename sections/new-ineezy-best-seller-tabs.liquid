{% schema %}
{
  "name": "Ineezy Best Seller Tabs",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "BEST SELLER COLLECTION"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "SHOP BY THE CATEGORY"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout Type",
      "options": [
        { "value": "slider", "label": "Slider" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to Show (per tab)",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "grid_columns",
      "label": "Grid Columns (Desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "info": "Only applies in Grid layout"
    },
    {
      "type": "checkbox",
      "id": "show_view_more",
      "label": "Show View More Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_more_text",
      "label": "View More Button Text",
      "default": "View More"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title",
          "default": "MEN'S"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "url",
          "id": "view_more_url",
          "label": "View More Link",
          "info": "Optional — leave blank to use the selected collection page."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "N_WEB Ineezy Best Seller Tabs"
    }
  ]
}
{% endschema %}

{%- assign is_slider = false -%}
{%- if section.settings.layout_type == 'slider' -%}
  {%- assign is_slider = true -%}
{%- endif -%}

<section class="ineezy-best-seller" id="ineezy-best-seller-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">

    <!-- TOP -->
    <div class="best-seller-top">

      <div class="new-main-title w-icon mb-0">
        <p>{{ section.settings.subtitle }}</p>
        <h2>{{ section.settings.title }}</h2>
      </div>

      <!-- ARROWS (slider mode only) -->
      {%- if is_slider -%}
        <div class="slider-arrows">
          <button class="bestSellerPrev-{{ section.id }}">
            <img src="{{ 'n-web-arrow-left.svg' | asset_url }}" alt="">
          </button>
          <button class="bestSellerNext-{{ section.id }}">
            <img src="{{ 'n-web-arrow-right.svg' | asset_url }}" alt="">
          </button>
        </div>
      {%- endif -%}

    </div>

    <!-- TABS -->
    <div class="best-seller-tabs">
      {% for block in section.blocks %}
        <button
          class="tab-btn {% if forloop.first %}active{% endif %}"
          data-tab="tab-{{ section.id }}-{{ forloop.index }}">
          {{ block.settings.tab_title }}
        </button>
      {% endfor %}
    </div>

    <!-- TAB CONTENT -->
    {% for block in section.blocks %}

      {%- assign collection = collections[block.settings.collection.handle] -%}
      {%- assign view_more_href = collection.url -%}
      {%- if block.settings.view_more_url != blank -%}
        {%- assign view_more_href = block.settings.view_more_url -%}
      {%- endif -%}

      <div
        class="tab-content {% if forloop.first %}active{% endif %}"
        id="tab-{{ section.id }}-{{ forloop.index }}"
        {% unless forloop.first %}style="display:none;"{% endunless %}
      >

        {%- if is_slider -%}

          <div class="best-seller-slider">
            {% for product in collection.products limit: section.settings.products_limit %}
              <div class="product-slide">
                {% render 'common-product-card-v2', product: product %}
              </div>
            {% endfor %}
          </div>

        {%- else -%}

          <div class="best-seller-grid" style="--grid-cols: {{ section.settings.grid_columns }};">
            {% for product in collection.products limit: section.settings.products_limit %}
              <div class="product-grid-item">
                {% render 'common-product-card-v2', product: product %}
              </div>
            {% endfor %}
          </div>

        {%- endif -%}

        {%- if section.settings.show_view_more and view_more_href != blank -%}
          <div class="best-seller-view-more">
            <a href="{{ view_more_href }}" class="btn btn-primary m-auto">{{ section.settings.view_more_text }}</a>
          </div>
        {%- endif -%}

      </div>

    {% endfor %}

  </div>
</section>
