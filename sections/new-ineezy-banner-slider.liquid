{% schema %}
{
  "name": "Ineezy Hero Slider",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
        {
          "type": "image_picker",
          "id": "bg_image_mobile",
          "label": "Mobile Background Image",
          "info": "Shown below 767px screen width. Falls back to the desktop image if left empty."
        },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "More Shine, Less Spend" },
        { "type": "text", "id": "title", "label": "Title", "default": "CHARM YOUR WAY" },
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "BUY 2, GET 1 FREE" },
        { "type": "url", "id": "button_link", "label": "Button Link" },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content Position",
          "default": "left",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ]
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text Alignment",
          "default": "left",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ]
        },
        { "type": "color", "id": "subtitle_color", "label": "Subtitle Color", "default": "#C5896F" },
        { "type": "color", "id": "title_color", "label": "Title Color", "default": "#21263C" },
        { "type": "header", "content": "Overlay" },
        { "type": "color", "id": "overlay_color", "label": "Overlay Color", "default": "#000000" },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay Opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 40,
          "unit": "%"
        }
      ]
    }
  ],
  "presets": [
    { "name": "N_WEB Ineezy Hero Slider" }
  ]
}
{% endschema %}

<section class="ineezy-hero-slider">
  <div class="ineezy-slider">

    {% for block in section.blocks %}
      {%- assign pos = block.settings.content_position | default: 'left' -%}
      {%- assign text_align = block.settings.text_align | default: 'left' -%}

      {%- if pos == 'left' -%}
        {%- assign justify = 'flex-start' -%}
      {%- elsif pos == 'right' -%}
        {%- assign justify = 'flex-end' -%}
      {%- else -%}
        {%- assign justify = 'center' -%}
      {%- endif -%}

      {%- if text_align == 'center' -%}
        {%- assign btn_margin = '0 auto' -%}
      {%- elsif text_align == 'right' -%}
        {%- assign btn_margin = '0 0 0 auto' -%}
      {%- else -%}
        {%- assign btn_margin = '0' -%}
      {%- endif -%}

      {%- assign mobile_bg_image = block.settings.bg_image_mobile | default: block.settings.bg_image -%}
      {%- assign alpha = block.settings.overlay_opacity | times: 1.0 | divided_by: 100 -%}
      {%- assign overlay_solid = block.settings.overlay_color | color_modify: 'alpha', alpha -%}
      {%- assign overlay_clear = block.settings.overlay_color | color_modify: 'alpha', 0 -%}

      {%- if pos == 'left' -%}
        {%- assign overlay_bg = 'linear-gradient(to right, ' | append: overlay_solid | append: ' 0%, ' | append: overlay_solid | append: ' 25%, ' | append: overlay_clear | append: ' 85%)' -%}
      {%- elsif pos == 'right' -%}
        {%- assign overlay_bg = 'linear-gradient(to left, ' | append: overlay_solid | append: ' 0%, ' | append: overlay_solid | append: ' 25%, ' | append: overlay_clear | append: ' 85%)' -%}
      {%- else -%}
        {%- assign overlay_bg = overlay_solid -%}
      {%- endif -%}

      <div class="slide-item">
        <div class="hero-bg"
          style="--hero-bg-desktop: {{ overlay_bg }}, url('{{ block.settings.bg_image | image_url: width: 1800 }}'); --hero-bg-mobile: {{ overlay_bg }}, url('{{ mobile_bg_image | image_url: width: 900 }}'); justify-content: {{ justify }};">

          <div class="hero-content" style="text-align: {{ text_align }};">
            <p class="subtitle" style="color: {{ block.settings.subtitle_color }};">{{ block.settings.subtitle }}</p>
            <h1 class="title" style="color: {{ block.settings.title_color }};">{{ block.settings.title }}</h1>

            {% if block.settings.button_text != blank %}
              <a href="{{ block.settings.button_link }}" class="btn btn-primary" style="margin: {{ btn_margin }};">
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>

        </div>
      </div>
    {% endfor %}

  </div>
</section>
