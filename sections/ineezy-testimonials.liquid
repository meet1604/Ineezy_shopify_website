{{ 'ineezy-reviews.css' | asset_url | stylesheet_tag }}

{%- assign ir_app_url = section.settings.app_url | default: settings.ineezy_app_url -%}

<section
  class="ineezy-section"
  style="
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  "
>
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <div class="ineezy-section-header" style="margin-bottom: 32px;">
        <div class="ineezy-section-title">{{ section.settings.heading | escape }}</div>
        {%- if section.settings.subheading != blank -%}
          <div class="ineezy-section-sub">{{ section.settings.subheading | escape }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="ineezy-reviews"
      data-ineezy-testimonials
      data-app-url="{{ ir_app_url | escape }}"
    ></div>

  </div>
</section>

<script src="{{ 'ineezy-reviews.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "INEEZY Testimonials",
  "tag": "section",
  "class": "ineezy-testimonials-section",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "info": "Your INEEZY Express app URL. Overrides the global theme setting."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real reviews from real customers"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FAFAF8"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "INEEZY Testimonials",
      "category": "Reviews"
    }
  ]
}
{% endschema %}
